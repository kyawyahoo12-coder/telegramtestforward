# Telegram API
API_ID=your_api_id
API_HASH=your_api_hash
SESSION=your_session_string_here   # Optional if using string session

# Channels (space separated)
FROM_CHANNEL=-1001234567890 -1009876543210
TO_CHANNEL=-100111222333 -100444555666

# Optional Settings
BLOCKED_TEXTS=spam,porn,blockedword
MEDIA_FORWARD_RESPONSE=yes
FORWARD_EDIT=no
DELAY=0.8
